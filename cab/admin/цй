<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админ-панель</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        #sidebar { min-width: 250px; background: #f8f9fa; }
        #content { padding: 20px; }
        .nav-link.active { background: #e9ecef !important; }
        .dynamic-content { display: none; }
        .dynamic-content.active { display: block; }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Боковое меню -->
        <div id="sidebar" class="p-3 border-end vh-100">
            <h4 class="mb-4">Меню</h4>
            <nav class="nav flex-column">
                <a class="nav-link active" data-target="users">Пользователи</a>
                <a class="nav-link" data-target="products">Товары</a>
                <a class="nav-link" data-target="orders">Заказы</a>
                <a class="nav-link" data-target="content">Контент</a>
                <a class="nav-link" data-target="feedback">Отзывы</a>
                <a class="nav-link" data-target="analytics">Аналитика</a>
                <a class="nav-link" data-target="settings">Настройки</a>
            </nav>
        </div>

        <!-- Основной контент -->
        <div id="content" class="flex-grow-1">
            <!-- Пользователи -->
            <div id="users" class="dynamic-content active">
                <h2>Пользователи</h2>
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Поиск...">
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Имя</th>
                            <th>Роль</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Данные из БД -->
                    </tbody>
                </table>
            </div>

            <!-- Товары -->
            <div id="products" class="dynamic-content">
                <h2>Товары</h2>
                <div class="row">
                    <div class="col-md-4">
                        <div class="list-group">
                            <a href="#" class="list-group-item">Категории</a>
                            <a href="#" class="list-group-item">Продукты</a>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <!-- Контент для категорий/продуктов -->
                    </div>
                </div>
            </div>

            <!-- Заказы -->
            <div id="orders" class="dynamic-content">
                <h2>Заказы</h2>
                <div class="mb-3">
                    <select class="form-select">
                        <option>Все статусы</option>
                        <option>Новый</option>
                        <option>Доставлен</option>
                    </select>
                </div>
                <!-- Таблица заказов -->
            </div>

            <!-- Контент -->
            <div id="content-section" class="dynamic-content">
                <h2>Контент</h2>
                <ul class="nav nav-tabs">
                    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#news">Новости</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#promotions">Акции</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane active" id="news">
                        <!-- Управление новостями -->
                    </div>
                    <div class="tab-pane" id="promotions">
                        <!-- Управление акциями -->
                    </div>
                </div>
            </div>

            <!-- Остальные разделы (аналогичная структура) -->
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Переключение разделов
        $('.nav-link').on('click', function() {
            $('.nav-link').removeClass('active');
            $(this).addClass('active');
            const target = $(this).data('target');
            $('.dynamic-content').removeClass('active');
            $('#' + target).addClass('active');
        });
    </script>
</body>
</html>